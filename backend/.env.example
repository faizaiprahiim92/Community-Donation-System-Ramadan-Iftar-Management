APP_NAME=Community Donation System
APP_VERSION=1.0.0
DEBUG=false

# Database - local dev uses SQLite; production uses Supabase PostgreSQL.
# Example (Supabase): postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./community_donation.db

# JWT - MUST be a long random string in production
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Supabase (project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage buckets (created automatically at startup)
STORAGE_BUCKET_PHOTOS=photos
STORAGE_BUCKET_VIDEOS=videos
